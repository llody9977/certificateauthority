  "opaPolicies": [
    {
      "id": "default-governance",
      "name": "Default Enterprise Compliance Policy",
      "enabled": true,
      "description": "Enforces strict profile validity, approved signature algorithms, and key sizes.",
      "rego": "package ca.issuance\n\ndefault allow = false\n\n# Approved Signature Algorithms\nallowed_algorithms = [\"ECDSA_P256\",\"ECDSA_P384\",\"RSA_2048\",\"RSA_4096\"]\n\n# Allowed Certificate & Credential Types\nallowed_types = [\"web_server\",\"acme_tls\",\"ssh_user\",\"ssh_host\"]\n\n# Maximum Validity Boundaries (Days)\nmax_days_by_profile = {\n    \"short_lived\": 7,\n    \"acme_tls\": 90,\n    \"standard\": 365,\n    \"ssh_user\": 30,\n    \"ssh_host\": 365\n}\n\n# Security Constraints\nallow_wildcards = false\nrequire_san = true\n\nallow {\n    input.algorithm == allowed_algorithms[_]\n    input.cert_type == allowed_types[_]\n    input.validity_days <= max_days_by_profile[input.profile]\n    valid_san_check\n    valid_wildcard_check\n}\n\nvalid_san_check {\n    require_san == false\n}\n\nvalid_san_check {\n    require_san == true\n    count(input.sans) > 0\n}\n\nvalid_wildcard_check {\n    allow_wildcards == true\n}\n\nvalid_wildcard_check {\n    allow_wildcards == false\n    input.profile == \"infrastructure\"\n}\n",
      "settings": {
        "allowedAlgorithms": [
          "ECDSA_P256",
          "ECDSA_P384",
          "RSA_2048",
          "RSA_4096"
        ],
        "allowedCertTypes": [
          "web_server",
          "acme_tls",
          "ssh_user",
          "ssh_host"
        ],
        "maxDaysByProfile": {
          "short_lived": 7,
          "acme_tls": 90,
          "standard": 365,
          "ssh_user": 30,
          "ssh_host": 365
        },
        "allowWildcards": false,
        "requireSan": true
      }
    }
  ],
